      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "crypto_price",
            "args": {
              "symbol": "BTC",
              "currency": "USDT"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_crypto_price",
        "difficulty": "medium",
        "what_it_tests": "Route chính xác câu hỏi giá crypto sang tool crypto_price với symbol=BTC và currency=USDT."
      }
    },
